generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FINANCEIRO vê e edita todas as unidades; GESTOR só a unidade dele.
enum UserRole {
  FINANCEIRO
  GESTOR
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String           @map("password_hash")
  role         UserRole
  unitId       String?          @map("unit_id")
  unit         Unit?            @relation(fields: [unitId], references: [id])
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  signedDocs   SignedDocument[]

  @@map("users")
}

/// Escola parceira (unidade). Os dados da instituição e do representante
/// legal preenchem os Anexos I e III.
model Unit {
  id             String           @id @default(cuid())
  name           String           @unique
  legalName      String           @map("legal_name")
  cnpj           String
  legalRepName   String           @map("legal_rep_name")
  legalRepCpf    String           @map("legal_rep_cpf")
  /// Profissional que atende os responsáveis (Anexo II).
  attendantName  String?          @map("attendant_name")
  attendantCpf   String?          @map("attendant_cpf")
  /// Cardápio das semanas A a D (Anexo XI) — ver src/lib/menu.ts.
  menu           Json?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  students       Student[]
  months         MonthlyReport[]
  users          User[]
  SignedDocument SignedDocument[]
  SignRequest    SignRequest[]

  @@map("units")
}

/// Criança do programa. As colunas seguem o Anexo X; o responsável é quem
/// assina os Anexos I (ciente), II, IV e V.
model Student {
  id                  String           @id @default(cuid())
  unitId              String           @map("unit_id")
  unit                Unit             @relation(fields: [unitId], references: [id])
  name                String
  shift               String
  grei                String
  birthDate           DateTime?        @map("birth_date") @db.Date
  phone               String?
  address             String?
  email               String?
  enrollmentDate      DateTime         @map("enrollment_date") @db.Date
  exitDate            DateTime?        @map("exit_date") @db.Date
  guardianName        String?          @map("guardian_name")
  guardianCpf         String?          @map("guardian_cpf")
  guardianPhone       String?          @map("guardian_phone")
  /// Entrega do material didático e uniforme (Anexo V, taxa única por aluno).
  materialDeliveredAt DateTime?        @map("material_delivered_at") @db.Date
  createdAt           DateTime         @default(now()) @map("created_at")
  attendances         Attendance[]
  SignedDocument      SignedDocument[]
  SignRequest         SignRequest[]

  @@index([unitId, name])
  @@map("students")
}

/// O mês de uma unidade: dias letivos e as faltas de cada criança.
model MonthlyReport {
  id          String       @id @default(cuid())
  unitId      String       @map("unit_id")
  unit        Unit         @relation(fields: [unitId], references: [id])
  year        Int
  month       Int
  schoolDays  Int?         @map("school_days")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attendances Attendance[]

  @@unique([unitId, year, month])
  @@map("monthly_reports")
}

model Attendance {
  id                  String        @id @default(cuid())
  reportId            String        @map("report_id")
  report              MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  studentId           String        @map("student_id")
  student             Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  justifiedAbsences   Int           @default(0) @map("justified_absences")
  unjustifiedAbsences Int           @default(0) @map("unjustified_absences")

  @@unique([reportId, studentId])
  @@map("attendances")
}

enum SignedDocType {
  ANEXO_I
  ANEXO_II
  ANEXO_III
  ANEXO_IV
  ANEXO_V
}

/// PAPEL = assinado à mão e digitalizado; DIGITAL = PDF com assinatura eletrônica.
enum SignMethod {
  PAPEL
  DIGITAL
  /// Assinado pela plataforma de assinatura (ZapSign): todos os signatários concluíram lá.
  PLATAFORMA
}

/// Anexo assinado de uma criança. O Anexo I é por mês (year/month); os
/// outros são assinados uma vez (year/month nulos) e valem para todos os meses.
model SignedDocument {
  id           String        @id @default(cuid())
  unitId       String        @map("unit_id")
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  studentId    String        @map("student_id")
  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type         SignedDocType
  year         Int?
  month        Int?
  fileName     String        @map("file_name")
  size         Int
  data         Bytes
  method       SignMethod
  /// Assinaturas lidas do PDF na hora do envio (ver src/lib/pdfSignatures.ts).
  signatures   Json          @default("[]")
  uploadedById String?       @map("uploaded_by_id")
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime      @default(now()) @map("uploaded_at")
  /// veio de um pedido da ZapSign (o original completo fica no pedido)
  requestId    String?       @map("request_id")
  request      SignRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([studentId, type])
  @@index([unitId, type, year, month])
  @@map("signed_documents")
}

/// Pedido de assinatura enviado à plataforma (ZapSign): UM documento por
/// criança e mês, com todos os anexos pendentes dela juntos (o responsável
/// assina tudo de uma vez). Quando volta assinado, cada anexo é separado
/// (ver src/services/signPackage.ts).
model SignRequest {
  id          String           @id @default(cuid())
  unitId      String           @map("unit_id")
  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  studentId   String           @map("student_id")
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// anexos que estão neste documento, na ordem das páginas
  types       SignedDocType[]
  /// mês de referência do pacote (o Anexo I é desse mês)
  year        Int
  month       Int
  /// { "ANEXO_I": [primeira página (0), quantidade], … }
  pageMap     Json             @default("{}") @map("page_map")
  provider    String           @default("ZAPSIGN")
  /// token do documento na ZapSign
  externalId  String           @map("external_id")
  /// [{ role: "responsável" | "escola", name, url, status, signedAt }]
  signers     Json
  /// PENDENTE | ASSINADO | RECUSADO
  status      String           @default("PENDENTE")
  /// criado pelo envio automático do mês
  auto        Boolean          @default(false)
  /// a ZapSign mandou o convite pelo WhatsApp
  whatsapp    Boolean          @default(false)
  /// PDF assinado completo, como veio da ZapSign (com o selo dela)
  signedFile  Bytes?           @map("signed_file")
  createdAt   DateTime         @default(now()) @map("created_at")
  completedAt DateTime?        @map("completed_at")
  documents   SignedDocument[]

  @@index([studentId, year, month])
  @@index([externalId])
  @@map("sign_requests")
}

/// Configurações gerais (uma linha só, id = "geral").
model Settings {
  id               String  @id @default("geral")
  /// envio automático dos pedidos de assinatura
  autoSendEnabled  Boolean @default(false) @map("auto_send_enabled")
  /// dia do mês do envio (1 a 28)
  autoSendDay      Int     @default(15) @map("auto_send_day")
  /// ATUAL = documentos do próprio mês; ANTERIOR = do mês anterior
  autoSendMonth    String  @default("ATUAL") @map("auto_send_month")
  /// a ZapSign envia o convite pelo WhatsApp do responsável
  autoSendWhatsapp Boolean @default(true) @map("auto_send_whatsapp")

  @@map("settings")
}

/// Cada envio automático (um por mês de referência).
model AutoSendRun {
  id      String   @id @default(cuid())
  year    Int
  month   Int
  runAt   DateTime @default(now()) @map("run_at")
  /// { sent, skipped: [{ unit, student, reason }], errors: [...] }
  summary Json

  @@unique([year, month])
  @@map("auto_send_runs")
}
